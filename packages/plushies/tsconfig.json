{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "plushies": ["./src/index.ts"],
      "plushies/viewer": ["./src/viewer.ts"],
      "@plushies/cursors": ["../cursors/src/index.ts"]
    }
  },
  "include": ["src", "test", "site", "build.ts"]
}
