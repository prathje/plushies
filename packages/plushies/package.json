{
  "name": "plushies",
  "version": "0.1.0",
  "description": "Soft 3D plush characters for three.js — 17 silhouettes, shell-textured fur, floating eyes, glasses and hats, squash & stretch.",
  "license": "MIT",
  "author": "Patrick Rathje",
  "repository": {"type": "git", "url": "git+https://github.com/prathje/plushies.git", "directory": "packages/plushies"},
  "homepage": "https://github.com/prathje/plushies/tree/main/packages/plushies#readme",
  "bugs": "https://github.com/prathje/plushies/issues",
  "type": "module",
  "main": "./dist/plushies.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/plushies.global.js",
  "jsdelivr": "./dist/plushies.global.js",
  "exports": {
    ".": {"types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/plushies.cjs"},
    "./viewer": {"types": "./dist/viewer.d.ts", "import": "./dist/viewer.js"},
    "./bundled": {"types": "./dist/bundled.d.ts", "import": "./dist/plushies.bundled.js"},
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": ["./site/*.ts", "./src/global.ts"],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test test/unit",
    "test:e2e": "bun test test/e2e",
    "site:dev": "bun --port 4517 site/index.html",
    "site:build": "bun run site/build.ts",
    "check": "bun run typecheck && bun run test && bun run build && bun run site:build"
  },
  "peerDependencies": {"three": ">=0.160.0"},
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/three": "^0.186.0",
    "playwright": "^1.55.0",
    "three": "^0.186.0",
    "typescript": "^5.9.3"
  },
  "keywords": ["three", "threejs", "character", "plush", "fur", "mascot", "3d", "webgl"]
}
