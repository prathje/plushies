{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "plushies": ["../plushies/src/index.ts"],
      "plushies/viewer": ["../plushies/src/viewer.ts"]
    }
  },
  "include": ["src", "test", "site"]
}
